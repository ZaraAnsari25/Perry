# Copy to .env (never commit .env). Each person fills in only what their packages use.

# Person A: browser agent model (Claude Haiku 5.5 via @anthropic-ai/sdk, which reads this name).
# ANTHROPIC_API_KEY=

# Person A: Apify
# APIFY_TOKEN=

# Person B: Factory Droid SDK (@factory/droid-sdk). Read by the SDK and the droid CLI it starts; the CLI must be on PATH.
# FACTORY_API_KEY=

# Local targets
BASELINE_URL=http://localhost:3001
PATCHED_URL=http://localhost:3002
DASHBOARD_URL=http://localhost:3000
