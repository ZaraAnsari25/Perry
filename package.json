{
  "name": "agentfix",
  "private": true,
  "description": "AgentFix: measure, diagnose, repair and verify how AI agents complete tasks on a website.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:dashboard": "npm run dev -w @agentfix/dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
