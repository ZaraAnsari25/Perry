{
  "name": "perry",
  "private": true,
  "description": "Perry: measure, diagnose, repair and verify how AI agents complete tasks on a website.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:dashboard": "npm run dev -w @agentfix/dashboard",
    "start:dashboard": "npm run start --workspace apps/dashboard",
    "start:store": "npm run start --workspace apps/storefront",
    "build:demo": "npm run build --workspace apps/storefront && npm run build --workspace apps/dashboard",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "serve:patched": "npm run serve:patched --workspace packages/optimizer --",
    "reset:demo": "npm run reset:demo --workspace packages/optimizer",
    "bench:interface": "npm run bench:interface -w @agentfix/benchmark",
    "bench:three": "npm run bench:interface -w @agentfix/benchmark -- --reps 5 --three",
    "interface:export": "npm run export -w @agentfix/agent-interface",
    "generate:interface": "npm run generate:interface -w @agentfix/optimizer --",
    "use:generated": "npm run use:generated -w @agentfix/optimizer --"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
